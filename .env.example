# Serveur
PORT=5000
NODE_ENV=development

# Base de données MongoDB Atlas
MONGO_URI=

# JWT (authentification)
JWT_SECRET=
JWT_EXPIRE=30d

# Cloudinary (stockage des photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Super Admin (compte créé automatiquement au premier démarrage)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Wave (paiement des abonnements, dons et dîmes)
# Clé API Wave Business (portail Wave > Développeurs). Jamais dans le code.
WAVE_API_KEY=
# Secret du webhook. URL à déclarer dans le portail Wave :
#   https://epuici-backend.onrender.com/api/dons/webhook-wave
# (événements checkout.session.completed et checkout.session.payment_failed)
WAVE_WEBHOOK_SECRET=
# Facultatif : secret de signature des requêtes, si la clé API l'exige
WAVE_SIGNING_SECRET=
# Tests sans clé Wave : true active une page de paiement simulée
WAVE_SIMULATION=false
# Adresse de la PWA, où Wave renvoie le fidèle après paiement
PWA_URL=https://epuici-app.web.app

# E-mail (envoi du code de réinitialisation de mot de passe)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=EPUICI <votre.adresse@gmail.com>

# URL de l'admin web (Vercel), utilisée pour le retour après paiement Wave
ADMIN_URL=https://epuici-admin.web.app
